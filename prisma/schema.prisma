datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Status {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING
  ARCHIVED
}

enum DomainType {
  SUBDOMAIN
  CUSTOM
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  DEMO_SCHEDULED
  DEMO_COMPLETED
  TRIAL_STARTED
  CONVERTED
  LOST
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  HALF_DAY
  ON_LEAVE
  HOLIDAY
}

enum LeaveRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING
  RESOLVED
  CLOSED
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERN
  TEMPORARY
}

// ----------------------------------------------------
// 1. CORE PLATFORM & TENANCY ENTITIES (PHASE 1)
// ----------------------------------------------------

model Organization {
  id                  String               @id @default(uuid())
  name                String
  slug                String               @unique
  organizationTypeId  String
  status              Status               @default(PENDING)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  organizationType    OrganizationType     @relation(fields: [organizationTypeId], references: [id])
  domains             Domain[]
  settings            OrganizationSettings?
  memberships         Membership[]
  roles               Role[]
  modules             OrganizationModule[]
  people              Person[]
  auditLogs           AuditLog[]
  units               OrganizationUnit[]
  departments         Department[]
  designations        Designation[]
  locations           Location[]
  leaveTypes          LeaveType[]
  leaveRequests       LeaveRequest[]
  leaveBalances       LeaveBalance[]
  leaveLedger         LeaveLedger[]
  attendanceEvents    AttendanceEvent[]
  attendanceSummaries AttendanceSummary[]
  documentTypes       DocumentType[]
  documents           Document[]
  ticketCategories    TicketCategory[]
  tickets             Ticket[]
  academicYears       AcademicYear[]
  faculties           Faculty[]
  courses             ProgramCourse[]
  batches             Batch[]
  sections            Section[]
  studentEnrollments  StudentEnrollment[]
  jobOpenings         JobOpening[]
  candidates          Candidate[]
  reviewCycles        ReviewCycle[]
  salaryStructures    SalaryStructure[]
  payrollRuns         PayrollRun[]
  customFields        CustomFieldDefinition[]
  forms               FormDefinition[]
  workflows           WorkflowDefinition[]
  notifications       Notification[]

  @@map("organizations")
}

model OrganizationType {
  id                  String         @id @default(uuid())
  code                String         @unique
  name                String
  defaultTerminology  Json
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  organizations       Organization[]

  @@map("organization_types")
}

model Domain {
  id                  String         @id @default(uuid())
  organizationId      String
  domain              String         @unique
  type                DomainType     @default(SUBDOMAIN)
  isPrimary           Boolean        @default(true)
  isVerified          Boolean        @default(true)
  createdAt           DateTime       @default(now())

  organization        Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("domains")
}

model User {
  id                  String         @id @default(uuid())
  email               String         @unique
  passwordHash        String
  fullName            String
  isPlatformStaff     Boolean        @default(false)
  status              Status         @default(ACTIVE)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  memberships         Membership[]
  personProfiles      Person[]
  assignedLeads       Lead[]         @relation("LeadAssignedUser")
  auditLogs           AuditLog[]
  assignedTickets     Ticket[]       @relation("TicketAssignedUser")

  @@map("users")
}

model Person {
  id                  String         @id @default(uuid())
  organizationId      String
  userId              String?
  personTypeCode      String         // EMPLOYEE, TEACHER, STUDENT, GUARDIAN, DOCTOR, WORKER, VOLUNTEER
  firstName           String
  lastName            String
  email               String?
  phone               String?
  status              Status         @default(ACTIVE)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  organization        Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user                User?          @relation(fields: [userId], references: [id], onDelete: SetNull)

  employeeProfile     EmployeeProfile?
  studentProfile      StudentProfile?
  guardianProfile     GuardianProfile?
  attendanceEvents    AttendanceEvent[]
  attendanceSummaries AttendanceSummary[]
  leaveBalances       LeaveBalance[]
  leaveLedger         LeaveLedger[]
  leaveRequests       LeaveRequest[]
  documents           Document[]
  tickets             Ticket[]

  @@map("people")
}

model Membership {
  id                  String         @id @default(uuid())
  organizationId      String
  userId              String
  status              Status         @default(ACTIVE)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  organization        Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user                User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  roles               Role[]         @relation("MembershipRoles")

  @@unique([organizationId, userId])
  @@map("memberships")
}

model Role {
  id                  String         @id @default(uuid())
  organizationId      String?
  name                String
  code                String
  isSystem            Boolean        @default(false)
  createdAt           DateTime       @default(now())

  organization        Organization?  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  permissions         Permission[]   @relation("RolePermissions")
  memberships         Membership[]   @relation("MembershipRoles")

  @@map("roles")
}

model Permission {
  id                  String         @id @default(uuid())
  code                String         @unique
  moduleCode          String
  description         String?

  roles               Role[]         @relation("RolePermissions")

  @@map("permissions")
}

model Module {
  id                  String               @id @default(uuid())
  code                String               @unique
  name                String
  description         String?
  isCore              Boolean              @default(false)

  organizationModules OrganizationModule[]

  @@map("modules")
}

model OrganizationModule {
  id                  String         @id @default(uuid())
  organizationId      String
  moduleId            String
  isEnabled           Boolean        @default(true)
  settings            Json?
  createdAt           DateTime       @default(now())

  organization        Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  module              Module         @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([organizationId, moduleId])
  @@map("organization_modules")
}

model OrganizationSettings {
  id                  String         @id @default(uuid())
  organizationId      String         @unique
  logoUrl             String?
  faviconUrl          String?
  primaryColor        String         @default("#0f172a")
  timezone            String         @default("UTC")
  currency            String         @default("USD")
  terminology         Json
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  organization        Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("organization_settings")
}

// ----------------------------------------------------
// 2. PLATFORM & CRM ENTITIES (PHASE 2)
// ----------------------------------------------------

model Plan {
  id                  String         @id @default(uuid())
  code                String         @unique
  name                String
  description         String
  monthlyPrice        Float
  annualPrice         Float
  currency            String         @default("USD")
  features            Json
  limits              Json
  displayOrder        Int            @default(0)
  isActive            Boolean        @default(true)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  @@map("plans")
}

model Lead {
  id                  String         @id @default(uuid())
  fullName            String
  email               String
  phone               String?
  orgName             String
  orgTypeCode         String
  peopleCount         String?
  country             String?
  preferredDate       String?
  preferredTime       String?
  modulesOfInterest   Json?
  message             String?
  status              LeadStatus     @default(NEW)
  assignedToUserId    String?
  notes               String?
  followUpDate        DateTime?
  convertedOrgId      String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  assignedToUser      User?          @relation("LeadAssignedUser", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  activities          LeadActivity[]

  @@map("leads")
}

model LeadActivity {
  id                  String         @id @default(uuid())
  leadId              String
  type                String
  description         String
  performedByUserId   String?
  createdAt           DateTime       @default(now())

  lead                Lead           @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@map("lead_activities")
}

model CmsContent {
  id                  String         @id @default(uuid())
  key                 String         @unique
  section             String
  title               String
  payload             Json
  isPublished         Boolean        @default(true)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  @@map("cms_contents")
}

model AuditLog {
  id                  String         @id @default(uuid())
  organizationId      String?
  userId              String?
  action              String
  entity              String
  entityId            String?
  details             Json?
  ipAddress           String?
  userAgent           String?
  createdAt           DateTime       @default(now())

  organization        Organization?  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user                User?          @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("audit_logs")
}

// ----------------------------------------------------
// 3. COMPLETE DOMAIN MODEL (PHASE 4)
// ----------------------------------------------------

// A. Organization Structure
model OrganizationUnit {
  id                  String             @id @default(uuid())
  organizationId      String
  name                String
  code                String
  unitType            String             // DIVISION, BRANCH, PLANT, CAMPUS
  parentId            String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  organization        Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parent              OrganizationUnit?  @relation("UnitParent", fields: [parentId], references: [id], onDelete: SetNull)
  children            OrganizationUnit[] @relation("UnitParent")
  departments         Department[]

  @@unique([organizationId, code])
  @@map("organization_units")
}

model Department {
  id                  String             @id @default(uuid())
  organizationId      String
  unitId              String?
  name                String
  code                String
  parentId            String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  organization        Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  unit                OrganizationUnit?  @relation(fields: [unitId], references: [id], onDelete: SetNull)
  parent              Department?        @relation("DeptParent", fields: [parentId], references: [id], onDelete: SetNull)
  children            Department[]       @relation("DeptParent")
  employees           EmployeeProfile[]

  @@unique([organizationId, code])
  @@map("departments")
}

model Designation {
  id                  String             @id @default(uuid())
  organizationId      String
  title               String
  code                String
  gradeLevel          String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  organization        Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employees           EmployeeProfile[]

  @@unique([organizationId, code])
  @@map("designations")
}

model Location {
  id                  String             @id @default(uuid())
  organizationId      String
  name                String
  code                String
  address             String?
  city                String?
  country             String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  organization        Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employees           EmployeeProfile[]

  @@unique([organizationId, code])
  @@map("locations")
}

// B. HR / Employee Domain
model EmployeeProfile {
  id                  String             @id @default(uuid())
  personId            String             @unique
  departmentId        String?
  designationId       String?
  locationId          String?
  employeeCode        String
  employmentType      EmploymentType     @default(FULL_TIME)
  joiningDate         DateTime           @default(now())
  managerPersonId     String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  person              Person             @relation(fields: [personId], references: [id], onDelete: Cascade)
  department          Department?        @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  designation         Designation?       @relation(fields: [designationId], references: [id], onDelete: SetNull)
  location            Location?          @relation(fields: [locationId], references: [id], onDelete: SetNull)
  history             EmploymentHistory[]

  @@map("employee_profiles")
}

model EmploymentHistory {
  id                  String             @id @default(uuid())
  employeeProfileId   String
  changeType          String             // PROMOTION, TRANSFER, JOINING, EXIT
  previousData        Json?
  newData             Json
  effectiveDate       DateTime           @default(now())
  createdAt           DateTime           @default(now())

  employeeProfile     EmployeeProfile    @relation(fields: [employeeProfileId], references: [id], onDelete: Cascade)

  @@map("employment_histories")
}

// C. Attendance Domain
model AttendanceEvent {
  id                  String             @id @default(uuid())
  organizationId      String
  personId            String
  eventType           String             // CHECK_IN, CHECK_OUT
  timestamp           DateTime           @default(now())
  source              String             @default("WEB") // WEB, BIOMETRIC, MOBILE
  location            String?
  createdAt           DateTime           @default(now())

  organization        Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  person              Person             @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@map("attendance_events")
}

model AttendanceSummary {
  id                  String             @id @default(uuid())
  organizationId      String
  personId            String
  date                DateTime
  status              AttendanceStatus   @default(PRESENT)
  workDurationMinutes Int                @default(0)
  overtimeMinutes     Int                @default(0)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  organization        Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  person              Person             @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([organizationId, personId, date])
  @@map("attendance_summaries")
}

// D. Leave Domain
model LeaveType {
  id                  String             @id @default(uuid())
  organizationId      String
  code                String
  name                String
  defaultDaysPerYear  Int                @default(12)
  isPaid              Boolean            @default(true)
  createdAt           DateTime           @default(now())

  organization        Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  leaveBalances       LeaveBalance[]
  leaveRequests       LeaveRequest[]

  @@unique([organizationId, code])
  @@map("leave_types")
}

model LeaveBalance {
  id                  String             @id @default(uuid())
  organizationId      String
  personId            String
  leaveTypeId         String
  allocatedDays       Float              @default(0)
  usedDays            Float              @default(0)
  pendingDays         Float              @default(0)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  organization        Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  person              Person             @relation(fields: [personId], references: [id], onDelete: Cascade)
  leaveType           LeaveType          @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)

  @@unique([organizationId, personId, leaveTypeId])
  @@map("leave_balances")
}

model LeaveRequest {
  id                  String             @id @default(uuid())
  organizationId      String
  personId            String
  leaveTypeId         String
  startDate           DateTime
  endDate             DateTime
  daysCount           Float
  reason              String?
  status              LeaveRequestStatus @default(PENDING)
  approvedByUserId    String?
  rejectionReason     String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  organization        Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  person              Person             @relation(fields: [personId], references: [id], onDelete: Cascade)
  leaveType           LeaveType          @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)

  @@map("leave_requests")
}

model LeaveLedger {
  id                  String             @id @default(uuid())
  organizationId      String
  personId            String
  transactionType     String             // ALLOCATION, DEDUCTION, ADJUSTMENT
  amount              Float
  description         String
  createdAt           DateTime           @default(now())

  organization        Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  person              Person             @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@map("leave_ledgers")
}

// E. Document Domain
model DocumentType {
  id                  String             @id @default(uuid())
  organizationId      String
  code                String
  name                String
  isRequired          Boolean            @default(false)

  organization        Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  documents           Document[]

  @@unique([organizationId, code])
  @@map("document_types")
}

model Document {
  id                  String             @id @default(uuid())
  organizationId      String
  personId            String
  documentTypeId      String
  title               String
  fileUrl             String
  verificationStatus  String             @default("PENDING") // PENDING, VERIFIED, REJECTED
  rejectionReason     String?
  expiryDate          DateTime?
  createdAt           DateTime           @default(now())

  organization        Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  person              Person             @relation(fields: [personId], references: [id], onDelete: Cascade)
  documentType        DocumentType       @relation(fields: [documentTypeId], references: [id], onDelete: Cascade)

  @@map("documents")
}

// F. Ticketing Domain
model TicketCategory {
  id                  String             @id @default(uuid())
  organizationId      String
  code                String
  name                String             // HR, IT, FACILITIES, ACADEMIC

  organization        Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tickets             Ticket[]

  @@unique([organizationId, code])
  @@map("ticket_categories")
}

model Ticket {
  id                  String             @id @default(uuid())
  organizationId      String
  personId            String
  categoryId          String
  title               String
  description         String
  priority            TicketPriority     @default(MEDIUM)
  status              TicketStatus       @default(OPEN)
  assignedToUserId    String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  organization        Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  person              Person             @relation(fields: [personId], references: [id], onDelete: Cascade)
  category            TicketCategory     @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  assignedUser        User?              @relation("TicketAssignedUser", fields: [assignedToUserId], references: [id], onDelete: SetNull)

  @@map("tickets")
}

// G. Education Domain (Optional Modular)
model AcademicYear {
  id                  String             @id @default(uuid())
  organizationId      String
  name                String             // 2026-2027
  startDate           DateTime
  endDate             DateTime
  isCurrent           Boolean            @default(true)

  organization        Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  enrollments         StudentEnrollment[]

  @@map("academic_years")
}

model Faculty {
  id                  String             @id @default(uuid())
  organizationId      String
  name                String
  code                String

  organization        Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  courses             ProgramCourse[]

  @@unique([organizationId, code])
  @@map("faculties")
}

model ProgramCourse {
  id                  String             @id @default(uuid())
  organizationId      String
  facultyId           String?
  name                String             // B.Tech Computer Science / Grade 10
  code                String

  organization        Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  faculty             Faculty?           @relation(fields: [facultyId], references: [id], onDelete: SetNull)
  batches             Batch[]

  @@unique([organizationId, code])
  @@map("program_courses")
}

model Batch {
  id                  String             @id @default(uuid())
  organizationId      String
  courseId            String
  name                String             // Batch of 2026

  organization        Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  course              ProgramCourse      @relation(fields: [courseId], references: [id], onDelete: Cascade)
  sections            Section[]

  @@map("batches")
}

model Section {
  id                  String             @id @default(uuid())
  organizationId      String
  batchId             String
  name                String             // Section A

  organization        Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  batch               Batch              @relation(fields: [batchId], references: [id], onDelete: Cascade)
  enrollments         StudentEnrollment[]

  @@map("sections")
}

model StudentProfile {
  id                  String             @id @default(uuid())
  personId            String             @unique
  studentRollNo       String
  admissionDate       DateTime           @default(now())

  person              Person             @relation(fields: [personId], references: [id], onDelete: Cascade)
  enrollments         StudentEnrollment[]

  @@map("student_profiles")
}

model StudentEnrollment {
  id                  String             @id @default(uuid())
  organizationId      String
  studentProfileId    String
  academicYearId      String
  sectionId           String
  status              Status             @default(ACTIVE)

  organization        Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  studentProfile      StudentProfile     @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  academicYear        AcademicYear       @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  section             Section            @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@map("student_enrollments")
}

model GuardianProfile {
  id                  String             @id @default(uuid())
  personId            String             @unique
  relationshipType    String             // FATHER, MOTHER, GUARDIAN

  person              Person             @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@map("guardian_profiles")
}

// H. Recruitment Domain
model JobOpening {
  id                  String             @id @default(uuid())
  organizationId      String
  title               String
  code                String
  description         String
  status              String             @default("OPEN") // OPEN, CLOSED, DRAFT
  createdAt           DateTime           @default(now())

  organization        Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  candidates          Candidate[]

  @@map("job_openings")
}

model Candidate {
  id                  String             @id @default(uuid())
  organizationId      String
  jobOpeningId        String
  fullName            String
  email               String
  phone               String?
  stage               String             @default("APPLIED") // APPLIED, SCREENING, INTERVIEW, OFFER, HIRED, REJECTED
  createdAt           DateTime           @default(now())

  organization        Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  jobOpening          JobOpening         @relation(fields: [jobOpeningId], references: [id], onDelete: Cascade)

  @@map("candidates")
}

// I. Performance Domain
model ReviewCycle {
  id                  String             @id @default(uuid())
  organizationId      String
  title               String             // Q3 2026 Appraisal Cycle
  startDate           DateTime
  endDate             DateTime
  status              String             @default("ACTIVE")

  organization        Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("review_cycles")
}

// J. Payroll Domain (Optional Modular)
model SalaryStructure {
  id                  String             @id @default(uuid())
  organizationId      String
  name                String
  baseMonthlyAmount   Float
  currency            String             @default("USD")

  organization        Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  payslips            Payslip[]

  @@map("salary_structures")
}

model PayrollRun {
  id                  String             @id @default(uuid())
  organizationId      String
  periodName          String             // August 2026
  status              String             @default("DRAFT") // DRAFT, REVIEW, APPROVED, FINALIZE
  processedCount      Int                @default(0)
  createdAt           DateTime           @default(now())

  organization        Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  payslips            Payslip[]

  @@map("payroll_runs")
}

model Payslip {
  id                  String             @id @default(uuid())
  payrollRunId        String
  salaryStructureId   String?
  netAmount           Float
  createdAt           DateTime           @default(now())

  payrollRun          PayrollRun         @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  salaryStructure     SalaryStructure?   @relation(fields: [salaryStructureId], references: [id], onDelete: SetNull)

  @@map("payslips")
}

// K. Configuration Domain
model CustomFieldDefinition {
  id                  String             @id @default(uuid())
  organizationId      String
  entityName          String             // PERSON, DEPARTMENT, TICKET
  fieldKey            String
  fieldLabel          String
  fieldType           String             // TEXT, NUMBER, SELECT, DATE, BOOLEAN
  options             Json?
  isRequired          Boolean            @default(false)
  createdAt           DateTime           @default(now())

  organization        Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, entityName, fieldKey])
  @@map("custom_field_definitions")
}

model FormDefinition {
  id                  String             @id @default(uuid())
  organizationId      String
  title               String
  entityName          String
  schema              Json
  isPublished         Boolean            @default(true)
  createdAt           DateTime           @default(now())

  organization        Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("form_definitions")
}

model WorkflowDefinition {
  id                  String             @id @default(uuid())
  organizationId      String
  title               String
  entityName          String             // LEAVE, ONBOARDING, RECRUITMENT
  states              Json
  transitions         Json
  createdAt           DateTime           @default(now())

  organization        Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("workflow_definitions")
}

model Notification {
  id                  String             @id @default(uuid())
  organizationId      String
  title               String
  message             String
  type                String             @default("INFO")
  isRead              Boolean            @default(false)
  createdAt           DateTime           @default(now())

  organization        Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("notifications")
}
