# =========================================================
# UNIVERSAL HRMS SAAS - PRODUCTION ENVIRONMENT CONFIGURATION
# =========================================================

# Database Configuration (PostgreSQL 18)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/universal_hrms?schema=public&connection_limit=10"

# Application Domains & Hostnames
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_ROOT_DOMAIN="localhost:3000"
NODE_ENV="development" # Set to "production" in production deployment

# Authentication & Session Security (HS256 JWT)
JWT_SECRET="e9a7c3b2f8a1d4e6c8b0a2f4d6e8c0b2a4f6d8e0c2b4a6f8d0e2c4b6a8f0d2e4"
SESSION_EXPIRY_HOURS=24

# Cloud Document Storage Provider Abstraction
# Options: "LOCAL" | "S3" | "GCS"
STORAGE_PROVIDER="LOCAL"
S3_ENDPOINT="https://s3.us-east-1.amazonaws.com"
S3_REGION="us-east-1"
S3_BUCKET="universal-hrms-documents-prod"
S3_ACCESS_KEY_ID="AKIAIOSFODNN7EXAMPLE"
S3_SECRET_ACCESS_KEY="wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY"

# Email Provider Abstraction
# Options: "CONSOLE" | "SMTP"
EMAIL_PROVIDER="CONSOLE"
SMTP_HOST="smtp.mailtrap.io"
SMTP_PORT=587
SMTP_USER="smtp_username_here"
SMTP_PASSWORD="smtp_password_here"
EMAIL_FROM="noreply@universalhrms.com"

# SMS Gateway Provider Abstraction (Optional)
# Options: "NONE" | "TWILIO" | "CUSTOM"
SMS_PROVIDER="NONE"
SMS_API_KEY=""
SMS_SENDER="HRMS"

# Rate Limiting Provider Abstraction
# Options: "MEMORY" | "REDIS"
RATE_LIMIT_PROVIDER="MEMORY"
REDIS_URL="redis://localhost:6379"

# Observability & Monitoring (Optional)
SENTRY_DSN=""
OPENTELEMETRY_ENDPOINT=""
